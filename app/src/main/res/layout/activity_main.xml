<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f"
    android:padding="6dp">
    
    <!-- Player VLC com SurfaceView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="45"
        android:background="#000000">
        
        <SurfaceView
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
        
        <ProgressBar
            android:id="@+id/spinner_bar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#6c5ce7"
            android:visibility="gone" />
    </FrameLayout>
    
    <!-- Painel de controle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="15"
        android:orientation="vertical"
        android:background="#1a1a2e"
        android:padding="4dp"
        android:layout_marginTop="2dp">
        
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pronto"
            android:textColor="#fff"
            android:textSize="11sp"
            android:layout_marginBottom="2dp" />
        
        <ProgressBar
            android:id="@+id/buffer_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="#6c5ce7"
            android:progressBackgroundTint="#33ffffff"
            android:visibility="gone" />
        
        <!-- Linha: Input + Botões GO e 📁 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            
            <EditText
                android:id="@+id/magnet_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="Magnet link..."
                android:textColorHint="#667788"
                android:inputType="textMultiLine"
                android:padding="6dp"
                android:textColor="#fff"
                android:textSize="10sp" />
            
            <Button
                android:id="@+id/btn_play"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/btn_primary"
                android:text="GO"
                android:textColor="#fff"
                android:textStyle="bold"
                android:textSize="11sp" />
            
            <Button
                android:id="@+id/btn_torrent"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/btn_primary"
                android:text="📁"
                android:textColor="#fff"
                android:textSize="14sp" />
        </LinearLayout>
        
        <!-- Linha: Botões ASSISTIR e PARAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            
            <Button
                android:id="@+id/btn_watch"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/btn_success"
                android:text="▶ ASSISTIR"
                android:textColor="#fff"
                android:textStyle="bold"
                android:textSize="11sp"
                android:visibility="gone" />
            
            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_danger"
                android:text="⏹ PARAR"
                android:textColor="#fff"
                android:textStyle="bold"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    
    <!-- Logs -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40"
        android:background="#0d0d1a"
        android:layout_marginTop="2dp">
        
        <TextView
            android:id="@+id/debug_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logs:"
            android:textColor="#00ff00"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:padding="4dp" />
    </ScrollView>
    
</LinearLayout>