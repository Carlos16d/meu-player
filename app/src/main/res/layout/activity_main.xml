<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a1a"
    android:padding="6dp">
    
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="25"
        android:layout_marginBottom="4dp"
        android:background="#000000">
        
        <SurfaceView
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
        
        <!-- Controles centrais (Play/Pause grande) -->
        <LinearLayout
            android:id="@+id/center_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">
            
            <Button
                android:id="@+id/btn_seek_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="⏪"
                android:textColor="#fff"
                android:textSize="22sp" />
            
            <Button
                android:id="@+id/btn_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/btn_primary"
                android:text="⏸"
                android:textColor="#fff"
                android:textSize="28sp" />
            
            <Button
                android:id="@+id/btn_seek_forward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="⏩"
                android:textColor="#fff"
                android:textSize="22sp" />
        </LinearLayout>
        
        <!-- Barra inferior -->
        <LinearLayout
            android:id="@+id/player_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#80000000"
            android:padding="8dp"
            android:visibility="gone">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="#fff"
                    android:textSize="10sp"
                    android:layout_marginEnd="8dp" />
                
                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#6c5ce7"
                    android:thumbTint="#fff"
                    android:progressBackgroundTint="#33FFFFFF" />
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">
                
                <Button
                    android:id="@+id/btn_audio"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="🎵 Áudio"
                    android:textColor="#fff"
                    android:textSize="11sp" />
                
                <Button
                    android:id="@+id/btn_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="📝 Legenda"
                    android:textColor="#fff"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        
        <!-- Menu de áudio -->
        <LinearLayout
            android:id="@+id/audio_menu"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="80dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:background="#E0000000"
            android:visibility="gone" />
        
        <!-- Menu de legenda -->
        <LinearLayout
            android:id="@+id/subtitle_menu"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="80dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:background="#E0000000"
            android:visibility="gone" />
        
        <ProgressBar
            android:id="@+id/spinner_bar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="#6c5ce7"
            android:visibility="gone" />
    </FrameLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="20"
        android:orientation="vertical"
        android:background="@drawable/glass_bg"
        android:padding="8dp"
        android:layout_marginBottom="4dp">
        
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎬 Torrent Stream"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        
        <ProgressBar
            android:id="@+id/buffer_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:progressTint="#6c5ce7"
            android:progressBackgroundTint="#33FFFFFF"
            android:visibility="gone"
            android:layout_marginTop="2dp" />
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            
            <EditText
                android:id="@+id/magnet_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="Magnet link..."
                android:textColorHint="#80FFFFFF"
                android:padding="6dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            
            <Button
                android:id="@+id/btn_play"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_primary"
                android:text="GO"
                android:textColor="#fff"
                android:textStyle="bold"
                android:textSize="10sp" />
            
            <Button
                android:id="@+id/btn_torrent"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_primary"
                android:text="📁"
                android:textColor="#fff"
                android:textSize="14sp" />
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            
            <Button
                android:id="@+id/btn_watch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_success"
                android:text="▶ ASSISTIR"
                android:textColor="#fff"
                android:textStyle="bold"
                android:textSize="11sp"
                android:visibility="gone" />
            
            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_danger"
                android:text="⏹ PARAR"
                android:textColor="#fff"
                android:textStyle="bold"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="55"
        android:background="@drawable/glass_bg">
        
        <TextView
            android:id="@+id/debug_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#AAFFFFFF"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:padding="6dp" />
    </ScrollView>
    
</LinearLayout>