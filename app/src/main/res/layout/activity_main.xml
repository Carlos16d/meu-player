<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f">
    
    <!-- Player PEQUENO (40% da tela) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:background="#000000">
        
        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:show_buffering="when_playing"
            app:use_controller="true"
            app:surface_type="texture_view"
            app:resize_mode="fit"
            app:controller_layout_id="@layout/exo_player_control_view" />
    </FrameLayout>
    
    <!-- Painel de controle e logs (60% da tela) -->
    <ScrollView
        android:id="@+id/glass_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:background="#1a1a2e"
        android:padding="8dp"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Torrent Streaming"
                android:textColor="#fff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                
                <TextView
                    android:id="@+id/progress_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pronto"
                    android:textColor="#aabbcc"
                    android:textSize="11sp" />
                
                <ProgressBar
                    android:id="@+id/buffer_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:progressTint="#6c5ce7"
                    android:progressBackgroundTint="#33ffffff"
                    android:visibility="gone" />
            </LinearLayout>
            
            <EditText
                android:id="@+id/magnet_input"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/input_bg"
                android:hint="Colar magnet link..."
                android:textColorHint="#667788"
                android:inputType="textMultiLine"
                android:padding="6dp"
                android:textColor="#fff"
                android:textSize="11sp" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                
                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="STREAM"
                    android:textColor="#fff"
                    android:textStyle="bold"
                    android:textSize="11sp" />
                
                <Button
                    android:id="@+id/btn_watch"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_success"
                    android:text="ASSISTIR"
                    android:textColor="#fff"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:visibility="gone" />
                
                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_danger"
                    android:text="PARAR"
                    android:textColor="#fff"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
            
            <!-- LOGS - OCUPA O RESTO DA TELA -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Logs:"
                android:textColor="#00ff00"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:maxLines="50"
                android:scrollbars="vertical"
                android:background="#0d0d1a"
                android:padding="4dp"
                android:gravity="bottom" />
        </LinearLayout>
    </ScrollView>
    
    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000">
        
        <ProgressBar
            android:id="@+id/spinner_bar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#6c5ce7" />
    </FrameLayout>
    
</LinearLayout>